# Asura's ghostty base. ghostty reads ~/.config/ghostty/config, which includes this
# file; `asura apps defaults` prints the one line to add. Included files load after
# the file that includes them, so put overrides in a later include (user.conf), not
# in ~/.config/ghostty/config itself.

config-file = colors
working-directory = home

font-family = "JetBrainsMono Nerd Font"
font-family = "JetBrains Mono"
font-size = 12

background-opacity = 0.85
background-blur-radius = 20

# The 4px grid.
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true

cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# Hyprland draws the border and the rounding; libadwaita's own titlebar would not
# follow the radius scale.
gtk-titlebar = false
window-theme = ghostty

# zsh is the login shell and the asura package depends on it. A known shell here is
# also what lets shell-integration = detect inject itself.
command = /usr/bin/zsh
shell-integration = detect

# Copy if text is selected, send SIGINT otherwise. Void ships Ghostty 1.1.3,
# where the `performable:` prefix exists and the `:mixed` action suffix does
# not — :mixed is newer Ghostty and shows a config-error dialog here.
keybind = ctrl+c=performable:copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+kp_add=increase_font_size:1
keybind = ctrl+kp_subtract=decrease_font_size:1
keybind = ctrl+kp_0=reset_font_size
