#!/bin/sh
# asura-boot-guard: monitors core runit daemon readiness and tracks boot success.
# Marks a boot as successful once seatd and asura-sysd are healthy.
exec 2>&1

STATUS_DIR="/var/lib/asura"
STATUS_FILE="$STATUS_DIR/boot-status"

mkdir -p "$STATUS_DIR"

# Wait for seatd and asura-sysd readiness (max 30s)
ready=0
for i in $(seq 1 30); do
    seatd_ok=0
    sysd_ok=0

    if [ -S /run/seatd.sock ] || sv status seatd 2>/dev/null | grep -q "^run:"; then
        seatd_ok=1
    fi

    if [ -S /run/asura/sysd.sock ] || sv status asura-sysd 2>/dev/null | grep -q "^run:"; then
        sysd_ok=1
    fi

    if [ "$seatd_ok" -eq 1 ] && [ "$sysd_ok" -eq 1 ]; then
        ready=1
        break
    fi
    sleep 1
done

if [ "$ready" -eq 1 ]; then
    printf "status=success\nlast_boot=%s\nfailed_count=0\nkernel=%s\n" \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$(uname -r)" > "$STATUS_FILE"
    echo "asura-boot-guard: core system services verified healthy"
else
    prev_fail=0
    if [ -f "$STATUS_FILE" ]; then
        prev_fail=$(grep '^failed_count=' "$STATUS_FILE" 2>/dev/null | cut -d= -f2 || echo 0)
    fi
    fail_count=$((prev_fail + 1))
    printf "status=degraded\nlast_check=%s\nfailed_count=%d\nkernel=%s\n" \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$fail_count" "$(uname -r)" > "$STATUS_FILE"
    echo "asura-boot-guard: WARNING: core services (seatd/asura-sysd) failed health check (failures: $fail_count)"

    # Trigger recovery action if failure threshold reached (3 consecutive failures)
    if [ "$fail_count" -ge 3 ]; then
        echo "asura-boot-guard: CRITICAL: 3 consecutive failed boots detected. Triggering recovery rollback..."
        # 1. Bootloader rollback: fall back to previous GRUB boot entry
        if command -v grub-reboot >/dev/null 2>&1; then
            echo "asura-boot-guard: setting GRUB fallback boot entry..."
            grub-reboot 1 2>/dev/null || true
        fi
        # 2. Btrfs snapshot recovery marker
        if [ -d "/.snapshots" ] && command -v btrfs >/dev/null 2>&1; then
            echo "asura-boot-guard: creating Btrfs rollback marker in /var/lib/asura/..."
            touch "$STATUS_DIR/rollback-requested" 2>/dev/null || true
        fi
    fi
fi

if command -v pause >/dev/null 2>&1; then
    exec pause
else
    exec sleep infinity
fi

