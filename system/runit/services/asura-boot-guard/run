#!/bin/sh
# asura-boot-guard: monitors core runit daemon readiness and, after three
# consecutive failed boots, rolls back to the most recent Btrfs snapshot via
# GRUB (GRUB_DEFAULT=saved, grub-reboot by exact menuentry title).
exec 2>&1

STATUS_DIR="/var/lib/asura"
STATUS_FILE="$STATUS_DIR/boot-status"

mkdir -p "$STATUS_DIR"

# Wait for seatd and asura-sysd readiness (max 30s)
ready=0
for i in $(seq 1 30); do
    seatd_ok=0
    sysd_ok=0

    if [ -S /run/seatd.sock ] || sv status seatd 2>/dev/null | grep -q "^run:"; then
        seatd_ok=1
    fi

    if [ -S /run/asura/sysd.sock ] || sv status asura-sysd 2>/dev/null | grep -q "^run:"; then
        sysd_ok=1
    fi

    if [ "$seatd_ok" -eq 1 ] && [ "$sysd_ok" -eq 1 ]; then
        ready=1
        break
    fi
    sleep 1
done

if [ "$ready" -eq 1 ]; then
    printf "status=success\nlast_boot=%s\nfailed_count=0\nkernel=%s\n" \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$(uname -r)" > "$STATUS_FILE"
    echo "asura-boot-guard: core system services verified healthy"
else
    prev_fail=0
    if [ -f "$STATUS_FILE" ]; then
        prev_fail=$(grep '^failed_count=' "$STATUS_FILE" 2>/dev/null | cut -d= -f2 || echo 0)
        case "$prev_fail" in ''|*[!0-9]*) prev_fail=0 ;; esac
    fi
    fail_count=$((prev_fail + 1))
    printf "status=degraded\nlast_check=%s\nfailed_count=%d\nkernel=%s\n" \
        "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$fail_count" "$(uname -r)" > "$STATUS_FILE"
    echo "asura-boot-guard: WARNING: core services (seatd/asura-sysd) failed health check (failures: $fail_count)"

    # Trigger recovery action if failure threshold reached (3 consecutive failures)
    if [ "$fail_count" -ge 3 ]; then
        echo "asura-boot-guard: CRITICAL: 3 consecutive failed boots detected. Triggering rollback..."
        # Find the most recent snapshot in /.snapshots
        latest=""
        if [ -d "/.snapshots" ]; then
            latest=$(ls -1 "/.snapshots" 2>/dev/null | sort -r | head -n 1)
        fi
        if [ -n "$latest" ] && command -v grub-reboot >/dev/null 2>&1; then
            echo "asura-boot-guard: rolling back to snapshot: $latest"
            grub-reboot "Asura OS (snapshot $latest)" 2>/dev/null || true
            # Reboot into the selected snapshot
            if command -v reboot >/dev/null 2>&1; then
                reboot
            fi
        else
            echo "asura-boot-guard: no snapshot available or grub-reboot missing; cannot roll back"
        fi
    fi
fi

if command -v pause >/dev/null 2>&1; then
    exec pause
else
    exec sleep infinity
fi
